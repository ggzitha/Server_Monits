# Application Environment Configuration
# Copy this file to .env and adjust variables as needed

# Environment
APP_ENV=production
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
API_V1_PREFIX=/api/v1

# Security & Encryption
# Fernet key persists on the Docker volume (/app/data/fernet.key) and is never regenerated.
FERNET_KEY=

# Database Connection (Stored outside DB)
# Examples:
# PostgreSQL: postgresql+asyncpg://monit_user:monit_pass@db:5432/monit_db
# MySQL:      mysql+asyncmy://monit_user:monit_pass@db:3306/monit_db
# MariaDB:    mysql+asyncmy://monit_user:monit_pass@db:3306/monit_db
# SQlite:    sqlite+aiosqlite:///server_monits_dev.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/server_monits

# Initial Admin (Required during Setup Wizard or via environment for auto-init)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@datacenter.internal

# Defaults
DEFAULT_LANGUAGE=en
DEFAULT_THEME=neon

# Sessions & Security
SESSION_COOKIE_NAME=monit_session
SESSION_EXPIRE_HOURS=24
CSRF_COOKIE_NAME=csrf_token
JWT_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Stream Gateway (Connects to existing Frigate instance)
# The Frigate go2rtc management API must NEVER be exposed to the public internet.
GO2RTC_API_URL=http://frigate:1984

# External MQTT Broker (Optional defaults for headless bootstrap; also configurable in Admin UI)
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=server_monits_client

# Telemetry Retention
TELEMETRY_RETENTION_DAYS=90
